# DSH Intel managed service example configuration.
# Source this file before running service/install.sh if the defaults do not fit.

# Installation prefix and persistent DSH home.
export DSH_MI_PREFIX="$HOME/.local/share/dsh-mac-intel"
export DSH_MI_HOME="$DSH_MI_PREFIX/home"

# Verified runtime versions used by the bootstrap installation.
export DSH_MI_NODE_VERSION="24.9.0"
export DSH_MI_PNPM_VERSION="11.28.5"
export DSH_MI_DSH_VERSION="0.2.2-rc.5"
export DSH_MI_PLUGIN_VERSION="2.8.5"

# Loopback bind address. Put TLS and an authenticated reverse proxy in front
# before exposing this port outside the server.
export DSH_MI_HOST="127.0.0.1"
export DSH_MI_PORT="3080"
